<?xml version="1.0" encoding="utf-8" ?>
<fetch distinct="false" aggregate="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../.xrmtools/schemas/Fetch.xsd">
  <entity name="account">
	  <attribute name="accountid" aggregate="count" alias="account_count"/>
	  <param name="filterXml">
		  <filter type="and">
			  <condition attribute="name" operator="like" value="a%" />
		  </filter>
	  </param>
  </entity>
</fetch>